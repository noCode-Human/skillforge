---
import Layout from '../layouts/Layout.astro';
---

<Layout title="SkillForge — The SKILL.md Factory">
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-xl border-b border-[var(--color-outline-variant)]">
    <div class="max-w-7xl mx-auto px-6 h-[72px] flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-[14px] bg-[var(--color-primary)] flex items-center justify-center text-white">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
            <path d="M9 15l2 2 4-4"/>
          </svg>
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-[var(--color-on-surface)]">SkillForge</span>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <div class="hidden sm:flex items-center">
          <script type='text/javascript' src='https://storage.ko-fi.com/cdn/widget/Widget_2.js'></script>
          <script type='text/javascript'>kofiwidget2.init('Support me on Ko-fi', '#343538', 'W7W01YQF8I');kofiwidget2.draw();</script>
        </div>
      </div>
    </div>
  </nav>

  <main class="pt-[72px]">
    <!-- Hero Section -->
    <section class="relative overflow-hidden px-6 pt-16 pb-12 md:pt-24 md:pb-16">
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-gradient-to-bl from-[var(--color-primary-container)] to-transparent rounded-full opacity-40 blur-3xl translate-x-1/3 -translate-y-1/3"></div>
        <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-gradient-to-tr from-[var(--color-secondary-container)] to-transparent rounded-full opacity-30 blur-3xl -translate-x-1/4 translate-y-1/4"></div>
      </div>
      
      <div class="max-w-4xl mx-auto relative">
        <div class="text-center mb-12 animate-slide-up">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-primary-container)] text-[var(--color-on-primary-container)] text-sm font-medium mb-6">
            <span class="w-2 h-2 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
            Production-ready SKILL.md generator
          </div>
          
          <h1 class="text-5xl md:text-7xl font-bold tracking-tight text-[var(--color-on-surface)] mb-6 text-balance leading-[1.1]">
            Turn any workflow into a<br />
            <span class="text-[var(--color-primary)]">world-class skill</span>
          </h1>
          
          <p class="text-lg md:text-xl text-[var(--color-on-surface-variant)] max-w-2xl mx-auto leading-relaxed">
            Describe your domain or workflow in a sentence. SkillForge generates a complete, production-grade 
            <code class="px-2 py-0.5 rounded-md bg-[var(--color-surface-variant)] text-[var(--color-primary)] font-mono text-sm">SKILL.md</code> 
            following Grok Build's best practices.
          </p>
        </div>
      </div>
    </section>

    <!-- Input Section -->
    <section class="px-6 pb-8">
      <div class="max-w-3xl mx-auto">
        <div class="material-card p-6 md:p-8 animate-slide-up stagger-2">
          <label for="description-input" class="block text-sm font-semibold text-[var(--color-on-surface)] mb-3">
            Describe your workflow or domain
          </label>
          <textarea
            id="description-input"
            class="material-input min-h-[120px] mb-4"
            placeholder="Example: Security audit for web applications — check for XSS, CSRF, insecure dependencies, and misconfigured headers. Output a detailed report with severity ratings and remediation steps."
          ></textarea>
          
          <div class="flex flex-wrap gap-2 mb-5">
            <span class="text-xs font-medium text-[var(--color-outline)] uppercase tracking-wider mr-2">Quick starters:</span>
            <button class="material-chip" data-example="1">React component builder</button>
            <button class="material-chip" data-example="2">Database schema migration</button>
            <button class="material-chip" data-example="3">API documentation writer</button>
            <button class="material-chip" data-example="4">Code review assistant</button>
            <button class="material-chip" data-example="5">Accessibility auditor</button>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
            <button id="generate-btn" class="material-button material-button--filled h-12 px-8 text-base flex-1 sm:flex-none">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3v18"/>
                <path d="M3 12h18"/>
              </svg>
              Generate SKILL.md
            </button>
            <button id="clear-btn" class="material-button material-button--outlined h-12 px-6">
              Clear
            </button>
            <button id="try-example-btn" class="text-sm text-[var(--color-primary)] font-medium hover:underline underline-offset-4 mt-2 sm:mt-0 sm:ml-2">
              Try an example →
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Output Section -->
    <section id="output-section" class="px-6 pb-20 hidden">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-2xl font-bold text-[var(--color-on-surface)]">Your SKILL.md</h2>
            <p class="text-sm text-[var(--color-on-surface-variant)] mt-1">Preview and copy to your project</p>
          </div>
          <div class="flex gap-3">
            <button id="copy-btn" class="material-button material-button--tonal h-10 px-5">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
              <span id="copy-label">Copy to clipboard</span>
            </button>
            <button id="download-btn" class="material-button material-button--filled h-10 px-5">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Download
            </button>
          </div>
        </div>
        
        <div class="grid lg:grid-cols-5 gap-6">
          <!-- Preview -->
          <div class="lg:col-span-3">
            <div class="material-card overflow-hidden">
              <div class="flex items-center gap-2 px-5 py-3 bg-[#1C1B1F] border-b border-white/10">
                <div class="w-3 h-3 rounded-full bg-[#FF5F57]"></div>
                <div class="w-3 h-3 rounded-full bg-[#FEBC2E]"></div>
                <div class="w-3 h-3 rounded-full bg-[#28C840]"></div>
                <span class="ml-3 text-xs text-white/50 font-mono">SKILL.md</span>
              </div>
              <div class="code-preview max-h-[70vh] overflow-y-auto" id="preview-panel"></div>
            </div>
          </div>
          
          <!-- Meta Panel -->
          <div class="lg:col-span-2 space-y-4">
            <div class="material-card p-6">
              <h3 class="text-sm font-semibold text-[var(--color-on-surface)] uppercase tracking-wider mb-4">Skill Details</h3>
              <div class="space-y-4">
                <div>
                  <label class="text-xs text-[var(--color-outline)] block mb-1">Name</label>
                  <div id="meta-name" class="font-mono text-sm text-[var(--color-on-surface)] bg-[var(--color-surface-variant)] px-3 py-2 rounded-xl"></div>
                </div>
                <div>
                  <label class="text-xs text-[var(--color-outline)] block mb-1">Domain</label>
                  <div id="meta-domain" class="text-sm text-[var(--color-on-surface)]"></div>
                </div>
                <div>
                  <label class="text-xs text-[var(--color-outline)] block mb-1">Sections</label>
                  <div id="meta-sections" class="flex flex-wrap gap-1.5"></div>
                </div>
                <div>
                  <label class="text-xs text-[var(--color-outline)] block mb-1">Estimated Lines</label>
                  <div id="meta-lines" class="text-sm text-[var(--color-on-surface)] font-mono"></div>
                </div>
              </div>
            </div>
            
            <div class="material-card p-6">
              <h3 class="text-sm font-semibold text-[var(--color-on-surface)] uppercase tracking-wider mb-3">Best Practices Checklist</h3>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5 text-sm text-[var(--color-on-surface-variant)]">
                  <svg class="w-5 h-5 text-[var(--color-secondary)] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  YAML frontmatter with name & description
                </li>
                <li class="flex items-start gap-2.5 text-sm text-[var(--color-on-surface-variant)]">
                  <svg class="w-5 h-5 text-[var(--color-secondary)] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  Description includes what + when to use
                </li>
                <li class="flex items-start gap-2.5 text-sm text-[var(--color-on-surface-variant)]">
                  <svg class="w-5 h-5 text-[var(--color-secondary)] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  Anti-patterns section included
                </li>
                <li class="flex items-start gap-2.5 text-sm text-[var(--color-on-surface-variant)]">
                  <svg class="w-5 h-5 text-[var(--color-secondary)] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  Verification steps defined
                </li>
                <li class="flex items-start gap-2.5 text-sm text-[var(--color-on-surface-variant)]">
                  <svg class="w-5 h-5 text-[var(--color-secondary)] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  Example invocations provided
                </li>
                <li class="flex items-start gap-2.5 text-sm text-[var(--color-on-surface-variant)]">
                  <svg class="w-5 h-5 text-[var(--color-secondary)] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  Imperative/infinitive voice used
                </li>
              </ul>
            </div>
            
            <div class="material-card p-6 bg-gradient-to-br from-[var(--color-primary-container)] to-[var(--color-tertiary-container)]">
              <h3 class="text-sm font-semibold text-[var(--color-on-primary-container)] uppercase tracking-wider mb-2">Installation</h3>
              <p class="text-sm text-[var(--color-on-primary-container)]/80 mb-3">
                Drop this skill into your skills directory:
              </p>
              <code class="block font-mono text-xs bg-black/10 text-[var(--color-on-primary-container)] px-4 py-3 rounded-xl">
                ~/.config/agents/skills/<br/>
                ~/.kimi/skills/<br/>
                ~/.claude/skills/
              </code>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Skills -->
    <section id="recent-skills" class="px-6 py-12 hidden">
      <div class="max-w-6xl mx-auto">
        <div class="flex items-center justify-between mb-6">
          <div>
            <h2 class="text-2xl font-bold text-[var(--color-on-surface)]">Recent Skills</h2>
            <p class="text-sm text-[var(--color-on-surface-variant)] mt-1">Your generated skills are saved locally</p>
          </div>
          <button id="clear-recent-btn" class="material-button material-button--outlined h-9 px-4 text-sm">
            Clear all
          </button>
        </div>
        <div id="recent-skills-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4"></div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="px-6 py-20 bg-[var(--color-surface-variant)]/50">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-on-surface)] mb-4">How SkillForge works</h2>
          <p class="text-lg text-[var(--color-on-surface-variant)] max-w-2xl mx-auto">
            Built on thousands of hours studying the best skills in the ecosystem
          </p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-8">
          <div class="material-card p-8 text-center animate-slide-up stagger-1">
            <div class="w-14 h-14 rounded-[20px] bg-[var(--color-primary-container)] text-[var(--color-on-primary-container)] flex items-center justify-center mx-auto mb-5 text-2xl font-bold">
              1
            </div>
            <h3 class="text-lg font-bold text-[var(--color-on-surface)] mb-2">Analyze</h3>
            <p class="text-sm text-[var(--color-on-surface-variant)] leading-relaxed">
              Parses your description to identify domain, action type, and workflow patterns using a comprehensive classification engine.
            </p>
          </div>
          
          <div class="material-card p-8 text-center animate-slide-up stagger-2">
            <div class="w-14 h-14 rounded-[20px] bg-[var(--color-secondary-container)] text-[var(--color-on-secondary-container)] flex items-center justify-center mx-auto mb-5 text-2xl font-bold">
              2
            </div>
            <h3 class="text-lg font-bold text-[var(--color-on-surface)] mb-2">Generate</h3>
            <p class="text-sm text-[var(--color-on-surface-variant)] leading-relaxed">
              Builds a tailored SKILL.md with proper YAML frontmatter, domain-specific workflows, anti-patterns, and verification steps.
            </p>
          </div>
          
          <div class="material-card p-8 text-center animate-slide-up stagger-3">
            <div class="w-14 h-14 rounded-[20px] bg-[var(--color-tertiary-container)] text-[var(--color-on-tertiary-container)] flex items-center justify-center mx-auto mb-5 text-2xl font-bold">
              3
            </div>
            <h3 class="text-lg font-bold text-[var(--color-on-surface)] mb-2">Ship</h3>
            <p class="text-sm text-[var(--color-on-surface-variant)] leading-relaxed">
              One-click copy or download as <code class="font-mono text-xs bg-[var(--color-surface-variant)] px-1.5 py-0.5 rounded">SKILL.md</code>. Drop into your skills folder and start using immediately.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="px-6 py-10 border-t border-[var(--color-outline-variant)]">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-xl bg-[var(--color-primary)] flex items-center justify-center text-white">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
              <polyline points="14 2 14 8 20 8"/>
            </svg>
          </div>
          <span class="font-semibold text-[var(--color-on-surface)]">SkillForge</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="https://github.com/noCode-Human/skillforge" target="_blank" rel="noopener" class="text-sm text-[var(--color-outline)] hover:text-[var(--color-primary)] transition-colors flex items-center gap-1.5">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            Star on GitHub
          </a>
          <span class="text-[var(--color-outline-variant)]">·</span>
          <p class="text-sm text-[var(--color-outline)]">
            Open-source template. Use it freely.
          </p>
        </div>
      </div>
    </footer>
  </main>

  <script is:inline>
    // ============================================================
    // SKILL.md Generation Engine
    // ============================================================

    const DOMAIN_PATTERNS = {
      code: ['code', 'programming', 'software', 'development', 'debug', 'refactor', 'build', 'implement', 'function', 'class', 'module', 'component', 'api', 'backend', 'frontend', 'fullstack'],
      design: ['design', 'ui', 'ux', 'interface', 'visual', 'layout', 'typography', 'color', 'component', 'screen', 'page', 'mockup', 'prototype', 'figma'],
      data: ['data', 'database', 'sql', 'query', 'analytics', 'metric', 'report', 'chart', 'visualization', 'etl', 'pipeline', 'warehouse', 'table', 'schema'],
      security: ['security', 'audit', 'vulnerability', 'penetration', 'scan', 'compliance', 'gdpr', 'hipaa', 'encrypt', 'auth', 'oauth', 'jwt', 'xss', 'csrf', 'injection'],
      devops: ['deploy', 'infrastructure', 'cloud', 'aws', 'gcp', 'azure', 'docker', 'kubernetes', 'k8s', 'ci/cd', 'pipeline', 'terraform', 'serverless', 'hosting'],
      content: ['content', 'write', 'document', 'blog', 'article', 'copy', 'marketing', 'seo', 'social', 'email', 'newsletter', 'description', 'narrative'],
      testing: ['test', 'testing', 'unit test', 'integration', 'e2e', 'cypress', 'playwright', 'jest', 'vitest', 'coverage', 'mock', 'fixture', 'assertion'],
      review: ['review', 'pr', 'pull request', 'code review', 'comment', 'feedback', 'approve', 'reject', 'suggestion', 'improvement'],
      migration: ['migration', 'migrate', 'upgrade', 'update', 'version', 'deprecat', 'legacy', 'modernize', 'convert', 'transform'],
      optimization: ['optimize', 'performance', 'speed', 'fast', 'slow', 'bottleneck', 'cache', 'lazy', 'bundle', 'memory', 'cpu', 'render'],
    };

    const ACTION_PATTERNS = {
      build: ['build', 'create', 'generate', 'make', 'scaffold', 'construct', 'develop', 'write', 'author'],
      audit: ['audit', 'review', 'inspect', 'check', 'scan', 'analyze', 'assess', 'evaluate', 'examine'],
      optimize: ['optimize', 'improve', 'enhance', 'refine', 'speed up', 'accelerate', 'boost', 'tune'],
      debug: ['debug', 'fix', 'repair', 'resolve', 'troubleshoot', 'diagnose', 'solve', 'patch'],
      migrate: ['migrate', 'upgrade', 'update', 'convert', 'transform', 'modernize', 'port'],
      test: ['test', 'verify', 'validate', 'check', 'assert', 'confirm', 'ensure'],
      deploy: ['deploy', 'ship', 'release', 'publish', 'launch', 'push', 'deliver'],
    };

    const EXAMPLE_PROMPTS = {
      1: "React component builder — generate reusable, accessible React components with TypeScript, Storybook stories, and unit tests. Follow atomic design principles and the project's existing component patterns.",
      2: "Database schema migration — plan and execute safe schema migrations for PostgreSQL. Generate migration scripts with rollback plans, validate data integrity, and handle zero-downtime deployments.",
      3: "API documentation writer — generate OpenAPI specs and developer documentation from code. Include request/response examples, error codes, authentication flows, and SDK usage samples.",
      4: "Code review assistant — analyze pull requests for bugs, security issues, performance problems, and style violations. Suggest specific improvements with code examples and prioritize by severity.",
      5: "Accessibility auditor — scan web interfaces for WCAG 2.1 AA violations. Check contrast ratios, keyboard navigation, ARIA usage, focus management, and screen reader compatibility. Output prioritized remediation plan.",
    };

    function detectDomain(description) {
      const lower = description.toLowerCase();
      const scores = {};
      for (const [domain, keywords] of Object.entries(DOMAIN_PATTERNS)) {
        scores[domain] = keywords.filter(k => lower.includes(k)).length;
      }
      const best = Object.entries(scores).sort((a, b) => b[1] - a[1])[0];
      return best[1] > 0 ? best[0] : 'general';
    }

    function detectAction(description) {
      const lower = description.toLowerCase();
      const scores = {};
      for (const [action, keywords] of Object.entries(ACTION_PATTERNS)) {
        scores[action] = keywords.filter(k => lower.includes(k)).length;
      }
      const best = Object.entries(scores).sort((a, b) => b[1] - a[1])[0];
      return best[1] > 0 ? best[0] : 'build';
    }

    function toKebabCase(str) {
      return str
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .substring(0, 64);
    }

    function generateSkillName(description, domain, action) {
      // Extract key nouns and verbs
      const words = description.toLowerCase().split(/\s+/);
      const stopWords = new Set(['a', 'an', 'the', 'and', 'or', 'for', 'to', 'in', 'on', 'at', 'with', 'from', 'by', 'of', 'is', 'are', 'was', 'were', 'be', 'been', 'being', 'have', 'has', 'had', 'do', 'does', 'did', 'will', 'would', 'could', 'should', 'may', 'might', 'must', 'can', 'this', 'that', 'these', 'those', 'i', 'you', 'he', 'she', 'it', 'we', 'they', 'me', 'him', 'her', 'us', 'them', 'my', 'your', 'his', 'her', 'its', 'our', 'their']);
      
      const meaningful = words.filter(w => w.length > 2 && !stopWords.has(w.replace(/[^a-z]/g, '')));
      
      // Try to find a good noun phrase
      let candidate = '';
      if (meaningful.length >= 2) {
        const first = meaningful[0];
        const second = meaningful.find(w => w !== first) || meaningful[1] || 'skill';
        candidate = `${first}-${second}`;
      } else if (meaningful.length === 1) {
        candidate = `${action}-${meaningful[0]}`;
      } else {
        candidate = `${action}-${domain}`;
      }
      
      return toKebabCase(candidate);
    }

    function generateDescription(description, domain, action) {
      const domainLabels = {
        code: 'code and software development',
        design: 'UI/UX design and visual interfaces',
        data: 'data processing and analytics',
        security: 'security auditing and vulnerability assessment',
        devops: 'DevOps and infrastructure management',
        content: 'content creation and documentation',
        testing: 'testing and quality assurance',
        review: 'code review and quality assessment',
        migration: 'migration and modernization',
        optimization: 'performance optimization',
        general: 'general workflow automation',
      };
      
      const actionLabels = {
        build: 'Build and generate',
