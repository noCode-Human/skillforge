**Iteration workflow:**

1. Use this skill on real tasks
2. Notice struggles or inefficiencies
3. Identify how SKILL.md should be updated
4. Implement changes and test again

Keep SKILL.md under 500 lines. Move detailed reference material to separate files when approaching this limit.`;

      return {
        markdown,
        name: skillName,
        domain,
        sections: [
          'YAML Frontmatter',
          'Overview',
          'When to Use',
          'Core Workflow',
          'Anti-Patterns',
          'Verification Steps',
          'Example Invocations',
          'Progressive Disclosure',
          'Skill Maintenance'
        ],
        lines: markdown.split('\n').length
      };
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function syntaxHighlight(markdown) {
      const lines = markdown.split('\n');
      return lines.map(line => {
        let html = escapeHtml(line);
        
        // YAML frontmatter
        if (line.match(/^---\s*$/)) {
          html = `<span class="syntax-yaml">${html}</span>`;
        }
        else if (line.match(/^(name|description):/)) {
          const [key, ...rest] = line.split(':');
          html = `<span class="syntax-key">${escapeHtml(key)}</span><span class="syntax-yaml">:</span><span class="syntax-string">${escapeHtml(rest.join(':'))}</span>`;
        }
        // Headings
        else if (line.match(/^#{1,3}\s/)) {
          html = `<span class="syntax-heading">${html}</span>`;
        }
        // Code blocks
        else if (line.match(/^\`\`\`/)) {
          html = `<span class="syntax-code">${html}</span>`;
        }
        // Bold text
        else if (line.match(/\*\*.+?\*\*/)) {
          html = html.replace(/\*\*(.+?)\*\*/g, '<span class="syntax-bold">**$1**</span>');
        }
        // Bullet points and numbered lists
        else if (line.match(/^[\s]*[-*]\s/) || line.match(/^[\s]*\d+\.\s/)) {
          html = `<span class="syntax-bullet">${html}</span>`;
        }
        
        return `<div class="leading-relaxed">${html || '&nbsp;'}</div>`;
      }).join('');
    }

    // ============================================================
    // UI Interactions
    // ============================================================

    const descriptionInput = document.getElementById('description-input');
    const generateBtn = document.getElementById('generate-btn');
    const clearBtn = document.getElementById('clear-btn');
    const outputSection = document.getElementById('output-section');
    const previewPanel = document.getElementById('preview-panel');
    const copyBtn = document.getElementById('copy-btn');
    const copyLabel = document.getElementById('copy-label');
    const downloadBtn = document.getElementById('download-btn');
    const metaName = document.getElementById('meta-name');
    const metaDomain = document.getElementById('meta-domain');
    const metaSections = document.getElementById('meta-sections');
    const metaLines = document.getElementById('meta-lines');

    let currentMarkdown = '';
    let currentName = '';

    // Example chips
    document.querySelectorAll('[data-example]').forEach(chip => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.example;
        descriptionInput.value = EXAMPLE_PROMPTS[id];
        descriptionInput.focus();
        // Highlight selected chip
        document.querySelectorAll('[data-example]').forEach(c => c.classList.remove('material-chip--active'));
        chip.classList.add('material-chip--active');
      });
    });

    generateBtn.addEventListener('click', () => {
      const description = descriptionInput.value.trim();
      if (!description) {
        descriptionInput.focus();
        descriptionInput.style.borderColor = 'var(--color-error)';
        setTimeout(() => {
          descriptionInput.style.borderColor = '';
        }, 2000);
        return;
      }

      // Loading state
      const originalBtnContent = generateBtn.innerHTML;
      generateBtn.innerHTML = `<svg class="animate-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg> Generating...`;
      generateBtn.disabled = true;

      // Small delay for UX
      setTimeout(() => {
      const result = generateSkillMarkdown(description);
      currentMarkdown = result.markdown;
      currentName = result.name;

      // Update preview
      previewPanel.innerHTML = syntaxHighlight(result.markdown);

      // Update meta
      metaName.textContent = result.name;
      metaDomain.textContent = result.domain.charAt(0).toUpperCase() + result.domain.slice(1);
      metaSections.innerHTML = result.sections.map(s => 
        `<span class="material-chip text-xs">${s}</span>`
      ).join('');
      metaLines.textContent = `~${result.lines} lines`;

      // Show output
      outputSection.classList.remove('hidden');
      outputSection.classList.add('animate-slide-up');
      
      // Scroll to output
      setTimeout(() => {
        outputSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);

      // Restore button
      generateBtn.innerHTML = originalBtnContent;
      generateBtn.disabled = false;
      }, 400);
    });

    clearBtn.addEventListener('click', () => {
      descriptionInput.value = '';
      outputSection.classList.add('hidden');
      document.querySelectorAll('[data-example]').forEach(c => c.classList.remove('material-chip--active'));
      descriptionInput.focus();
    });

    document.getElementById('try-example-btn').addEventListener('click', () => {
      descriptionInput.value = EXAMPLE_PROMPTS[1];
      document.querySelectorAll('[data-example]').forEach(c => c.classList.remove('material-chip--active'));
      document.querySelector('[data-example="1"]').classList.add('material-chip--active');
      generateBtn.click();
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(currentMarkdown);
        copyLabel.textContent = 'Copied!';
        copyBtn.classList.add('material-chip--active');
        setTimeout(() => {
          copyLabel.textContent = 'Copy to clipboard';
          copyBtn.classList.remove('material-chip--active');
        }, 2000);
      } catch (err) {
        // Fallback
        const textarea = document.createElement('textarea');
        textarea.value = currentMarkdown;
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand('copy');
        document.body.removeChild(textarea);
        copyLabel.textContent = 'Copied!';
        setTimeout(() => {
          copyLabel.textContent = 'Copy to clipboard';
        }, 2000);
      }
    });

    downloadBtn.addEventListener('click', () => {
      const blob = new Blob([currentMarkdown], { type: 'text/markdown' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `SKILL.md`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });

    // Keyboard shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        generateBtn.click();
      }
    });

    // Recent Skills with localStorage
    const recentSection = document.getElementById('recent-skills');
    const recentGrid = document.getElementById('recent-skills-grid');
    const clearRecentBtn = document.getElementById('clear-recent-btn');
    const STORAGE_KEY = 'skillforge-recent';
    const MAX_RECENT = 6;

    function loadRecent() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      } catch {
        return [];
      }
    }

    function saveRecent(skills) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(skills.slice(0, MAX_RECENT)));
    }

    function addRecent(name, domain, description, markdown) {
      const recent = loadRecent();
      const existing = recent.findIndex(r => r.name === name);
      if (existing >= 0) recent.splice(existing, 1);
      recent.unshift({ name, domain, description, markdown, date: new Date().toISOString() });
      saveRecent(recent);
      renderRecent();
    }

    function renderRecent() {
      const recent = loadRecent();
      if (recent.length === 0) {
        recentSection.classList.add('hidden');
        return;
      }
      recentSection.classList.remove('hidden');
      recentGrid.innerHTML = recent.map(skill => `
        <div class="material-card p-5 cursor-pointer hover:shadow-[var(--shadow-3)] transition-all group" data-skill="${encodeURIComponent(skill.name)}">
          <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-[var(--color-primary-container)] text-[var(--color-on-primary-container)] flex items-center justify-center text-lg font-bold shrink-0">
              ${skill.name.charAt(0).toUpperCase()}
            </div>
            <span class="material-chip text-xs">${skill.domain}</span>
          </div>
          <h3 class="font-semibold text-[var(--color-on-surface)] mb-1 truncate">${skill.name}</h3>
          <p class="text-sm text-[var(--color-on-surface-variant)] line-clamp-2 mb-3">${skill.description}</p>
          <div class="flex items-center gap-2 text-xs text-[var(--color-outline)]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
            ${new Date(skill.date).toLocaleDateString()}
          </div>
        </div>
      `).join('');

      recentGrid.querySelectorAll('[data-skill]').forEach(card => {
        card.addEventListener('click', () => {
          const name = decodeURIComponent(card.dataset.skill);
          const skill = loadRecent().find(r => r.name === name);
          if (skill) {
            descriptionInput.value = skill.description;
            currentMarkdown = skill.markdown;
            currentName = skill.name;
            previewPanel.innerHTML = syntaxHighlight(skill.markdown);
            metaName.textContent = skill.name;
            metaDomain.textContent = skill.domain.charAt(0).toUpperCase() + skill.domain.slice(1);
            metaSections.innerHTML = ['YAML Frontmatter', 'Overview', 'When to Use', 'Core Workflow', 'Anti-Patterns', 'Verification Steps', 'Example Invocations', 'Progressive Disclosure', 'Skill Maintenance'].map(s => 
              `<span class="material-chip text-xs">${s}</span>`
            ).join('');
            metaLines.textContent = `~${skill.markdown.split('\n').length} lines`;
            outputSection.classList.remove('hidden');
            outputSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    }

    clearRecentBtn.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      renderRecent();
    });

    // Save to recent when generating
    const originalGenerateBtnHandler = generateBtn.onclick;
    // We hook into the existing handler by wrapping the result generation
    const originalGenerateFn = generateSkillMarkdown;
    generateSkillMarkdown = function(description) {
      const result = originalGenerateFn(description);
      addRecent(result.name, result.domain, description, result.markdown);
      return result;
    };

    renderRecent();

    // Console easter egg
    console.log('%c SkillForge ', 'background: #B84D38; color: white; padding: 4px 12px; border-radius: 100px; font-weight: bold;');
    console.log('%cDescribe any workflow and generate production-grade SKILL.md files. Try Cmd/Ctrl + Enter to generate.', 'color: #49454F;');
  </script>
</Layout>
